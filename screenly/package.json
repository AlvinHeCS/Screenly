{
  "name": "screenly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\" --cache --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\" --cache --ignore-path .gitignore",
    "db:generate": "pnpm -F @screenly/db generate",
    "db:push": "pnpm -F @screenly/db push",
    "db:migrate": "pnpm -F @screenly/db migrate",
    "db:studio": "pnpm -F @screenly/db studio",
    "postinstall": "pnpm -F @screenly/db generate"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.3.3",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  }
}
