# Copy this file to `.env` and fill in values. Only `.env.example` is committed.
# When adding a variable, also add it to `apps/web/src/env.js`.

# ── Database (Postgres) ───────────────────────────────────────────────────────
# Production (Supabase/Neon): the app uses a POOLED, transaction-mode connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/screenly"
DIRECT_URL="postgresql://postgres:password@localhost:5432/screenly"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate a secret with: npx auth secret   (required in production)
AUTH_SECRET=""
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Cloudflare Stream (video upload / transcode / HLS streaming) ──────────────
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_TOKEN=""
STREAM_WEBHOOK_SECRET=""

# ── Inngest (background workflows: transcription, notifications, rollups) ──────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
